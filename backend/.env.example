# Backend API Configuration
PORT=3002

# ============================================================================
# 数据库配置
# ============================================================================

# PostgreSQL 连接串（本地直跑 backend/main.py 时使用）
# 格式: postgresql+psycopg://user:password@host:port/database
# Docker Compose 部署时，此值会被 docker-compose.yml 的 backend.environment.DATABASE_URL 覆盖
# 在容器内，数据库主机名应为 'db'（compose 服务名）
DATABASE_URL=postgresql+psycopg://xpouch_admin:admin123@db:5432/xpouch_ai

# PostgreSQL 数据库配置（用于 Docker 部署）
POSTGRES_USER=xpouch_admin
POSTGRES_PASSWORD=your-secure-password-change-in-production
POSTGRES_DB=xpouch_ai

# SQLite 连接串（已废弃，仅用于本地开发调试）
# DATABASE_URL=sqlite:////app/data/database.db

# ============================================================================
# LLM 提供商 API Key 配置
# ============================================================================
# 说明：
# - 只在此文件配置 API Key（敏感信息）
# - 其他配置（base_url、模型名等）在 providers.yaml 中设置
# - 添加新提供商只需：1) 在 providers.yaml 添加配置 2) 在此添加 API Key
# - 配置优先级：DeepSeek > OpenAI > Anthropic > Google（2026-09 起 MiniMax 已停用）
#
# 支持的提供商（在 providers.yaml 配置）：
# - deepseek: 性价比高，通用对话（默认推荐，deepseek-v4-flash）
# - openai: GPT 系列，代码和复杂任务
# - anthropic: Claude 系列，长文本和研究
# - google: Gemini 系列，多模态
# - moonshot: Kimi 系列，多模态
# - minimax: 已停用（2026-09，余额耗尽且效果一般），恢复见 providers.yaml
# ============================================================================

# DeepSeek 配置（推荐，性价比高）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# OpenAI 配置（可选）
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic 配置（可选）
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google 配置（可选）
GOOGLE_API_KEY=your-google-api-key

# Moonshot / 月之暗面（Kimi 系列，长文本处理）
MOONSHOT_API_KEY=your-moonshot-api-key

# MiniMax（已停用 2026-09：余额耗尽且效果一般；如需恢复，先在 providers.yaml 改回 enabled: true）
# MINIMAX_API_KEY=your-minimax-api-key

# ============================================================================
# 工具 API Key 配置
# ============================================================================

# Tavily 联网搜索 API Key（解决模型知识滞后问题）
# 注册地址：https://tavily.com（免费版每月 1000 次查询）
# 功能：提供实时新闻、股价、天气、冷知识等搜索能力
# 注意：不配置则搜索工具不可用，但不影响其他功能
TAVILY_API_KEY=tvly-your-tavily-key-here

# ============================================================================
# 向量嵌入模型配置（用于长期记忆系统）
# ============================================================================

# 硅基流动 API Key（推荐使用，提供 BAAI/bge-m3 免费嵌入模型）
# 注册地址：https://siliconflow.cn
# 注意：模型配置在 providers.yaml 中管理，此处只需配置 API Key
SILICON_API_KEY=your-silicon-api-key

# ============================================================================
# LangSmith 追踪配置（可选）
# ============================================================================

# 启用 LangChain V2 追踪
LANGCHAIN_TRACING_V2=true

# LangSmith API 密钥（从 https://smith.langchain.com 获取）
LANGCHAIN_API_KEY=lsv2_pt_your-key-here

# LangSmith 项目名称
LANGCHAIN_PROJECT=xpouch-ai

# ============================================================================
# 认证配置
# ============================================================================

# JWT密钥（生产环境请使用强密钥，可通过以下命令生成：python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Access token有效期（分钟），默认 60；双 Token 架构下前端静默刷新
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=60

# ============================================================================
# 腾讯云短信服务配置
# ============================================================================

# 从腾讯云控制台获取：https://console.cloud.tencent.com/smsv2
# 短信签名需审核，模板需审核
TENCENT_CLOUD_SECRET_ID=your-tencent-cloud-secret-id
TENCENT_CLOUD_SECRET_KEY=your-tencent-cloud-secret-key
SMS_SDK_APP_ID=1400000000  # 应用ID
SMS_SIGN_NAME=您的签名
SMS_TEMPLATE_ID=123456  # 模板ID
SMS_REGION=ap-guangzhou  # 地域（默认广州）

# ============================================================================
# CORS 配置
# ============================================================================

# 允许的跨域来源，多个域名用逗号分隔
# 开发环境：http://localhost:5173
# 生产环境：https://your-domain.com
CORS_ORIGINS=http://localhost:5173

# 运行环境：development / testing / production
# ⚠️ Fail-closed：必须显式设置。未设置时按 production 处理（debug 端点关闭、
#    X-User-ID 认证旁路关闭、生产级 JWT 校验生效）。
#    本地开发请显式设为 development。
ENVIRONMENT=production

# 系统默认模型（简单模式跟随；管理员也可在「设置 → 模型配置」在线修改全局默认）
# MODEL_NAME=deepseek-flash

# 发码 IP 频控：同一 IP 每小时最大成功发码次数（公共注册站短信成本止损；0 = 不限制）
# SMS_IP_MAX_SENDS_PER_HOUR=10

# 日志格式：text（默认，人类可读）/ json（每行一个 JSON 对象，便于机器解析与日志平台采集）
# LOG_FORMAT=text
# 日志级别：默认 INFO
# LOG_LEVEL=INFO

# 专家工具调用开关（默认 true；false 可禁用联网搜索等工具，平滑升级兼容）
# ENABLE_TOOL_CALLING=true

# ============================================================================
# 应用配置（可选，使用默认值即可）
# ============================================================================

# 注：版本号没有环境变量——唯一真相源是 backend/pyproject.toml（utils/version.py 读取）

# ============================================================================
# 运维配置（可选，使用默认值即可）
# ============================================================================

# 会话清理间隔（分钟）
# SESSION_CLEANUP_INTERVAL_MINUTES=60

# 会话保留天数
# THREAD_RETENTION_DAYS=90

# SSE 心跳间隔（秒）
# HEARTBEAT_INTERVAL=15.0

# SSE 强制心跳间隔（秒）
# FORCE_HEARTBEAT_INTERVAL=30.0

# 流式响应超时（秒）
# STREAM_TIMEOUT=120.0

# 递归深度限制
# RECURSION_LIMIT=100

# ============================================================================
# 运行层（可选项，通常不用改）
# ============================================================================

# 单次 run 的执行预算（秒）：超时即判失败并收口
# RUN_DEADLINE_SECONDS=900

# 单次 LLM 调用超时（秒）。防模型端悬挂时无限 await——专家按任务级失败、
# commander/aggregator 快速失败。需显著大于正常单次调用耗时
# LLM_CALL_TIMEOUT_SECONDS=420

# 同层任务并发上限（复杂任务的波次扇出）。
#   1 = 串行（默认，也是历史行为）；>1 = 同层就绪任务并发。
# ⚠️ 这只是**环境变量兜底值**：实际生效值以管理端「系统状态」页的配置为准，
#    再其次才是本值（见 services/run_concurrency.py）。
# GRAPH_MAX_CONCURRENCY=1

# ============================================================================
# 安全限制（可选，使用默认值即可）
# ============================================================================

# 最大上传文件大小（MB）
# MAX_UPLOAD_SIZE_MB=10

# 请求超时（秒）
# REQUEST_TIMEOUT_SECONDS=120

# ============================================================================
# 数据库连接池（可选，默认值适用于单实例部署）
# ============================================================================

# DB_POOL_MIN_SIZE=5
# DB_POOL_MAX_SIZE=20
# DB_POOL_TIMEOUT=30.0
# DB_POOL_MAX_IDLE=300.0        # 与 pool_recycle 一致，防云数据库断开
# DB_POOL_MAX_LIFETIME=7200.0   # 单连接最长存活（秒）

# ============================================================================
# 风控与限流（可选，默认值适用于公共注册站；私有部署可放宽）
# ============================================================================

# 验证码：长度 / 有效期 / 最大尝试 / 锁定时长
# VERIFICATION_CODE_LENGTH=6
# VERIFICATION_CODE_EXPIRE_MINUTES=5
# VERIFICATION_CODE_MAX_ATTEMPTS=5
# VERIFICATION_CODE_LOCKOUT_MINUTES=10

# 发码频率：同 identifier 冷却、窗口与窗口内上限
# VERIFICATION_CODE_SEND_COOLDOWN_SECONDS=60
# VERIFICATION_CODE_SEND_WINDOW_MINUTES=30
# VERIFICATION_CODE_MAX_SENDS_PER_WINDOW=5

# 密码登录防爆破：窗口内最大失败次数 / 窗口长度（内存限流，重启清零）
# PASSWORD_MAX_ATTEMPTS=10
# PASSWORD_ATTEMPT_WINDOW_MINUTES=5

# 开发环境短信通道不可用时的降级：true = 记警告日志并按「发送成功」处理
# （仅本地调试用；生产必须保持 false，否则收不到码却提示已发送）
# SMS_CONSOLE_FALLBACK_ENABLED=false

# ============================================================================
# 模型与工具开关（可选）
# ============================================================================

# 强制走 fallback 模型
# FORCE_MODEL_FALLBACK=false

# 是否允许 OpenAI 系列模型出现在可选清单
# ALLOW_OPENAI_MODELS=false

# 追加 MCP Server（JSON 字符串；也可在管理台维护）
# MCP_SERVERS=

# ============================================================================
# 初始管理员配置
# ============================================================================

# 方式1：通过环境变量自动初始化（推荐）
# 用户注册后，重启应用即可自动提升为管理员
# 注意：邮箱和手机号二选一，邮箱优先级更高

# 初始管理员邮箱（推荐）
# INITIAL_ADMIN_EMAIL=admin@example.com

# 初始管理员手机号（纯数字，不带+86）
# INITIAL_ADMIN_PHONE=13800138000

# 方式2：通过命令行脚本手动提升（灵活）
# uv run python scripts/promote_admin.py admin@example.com
# uv run python scripts/promote_admin.py 13800138000 --phone

# 查看所有管理员：
# uv run python scripts/promote_admin.py --list

# ============================================================================
# 说明
# ============================================================================

# 1. 复制此文件为 .env
# 2. 填写至少一个 LLM API Key
# 3. 如需记忆系统功能，配置 SILICON_API_KEY
# 4. 根据需要配置 LangSmith 追踪
# 5. 上述标记为 "可选" 的配置都有默认值， Uncomment 后修改才生效
# 6. .env 文件已在 .gitignore 中，不会被提交到代码仓库
