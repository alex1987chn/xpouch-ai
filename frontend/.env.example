# Frontend Environment Variables
# ============================================================================
#
# 使用说明：
# 1. 本地覆盖请复制此文件为 .env.local（已被 .gitignore 排除）
#    ⚠️ .env.development / .env.production **不在**忽略列表内（会被提交），
#       只放公开配置，别放任何密钥
# 2. 修改对应的 API 地址和调试选项
# 3. 所有 VITE_ 前缀变量会在构建时注入前端代码（可被浏览器看到）
# 4. 前端环境变量中禁止放置任何密钥/口令（JWT/数据库/LLM API Key 等）
#
# 安全提示：VITE_* 变量不是“保密变量”，仅适合放公开配置
#
# ============================================================================

# ============================================================================
# API 配置
# ============================================================================

# 后端 API 基础地址
# 开发环境（本地代理）: /api
# 生产环境: https://your-domain.com/api 或 /api（同域部署）
VITE_API_BASE_URL=/api

# ============================================================================
# 调试配置
# ============================================================================

# 是否启用调试模式
# 开发环境: true（显示详细日志、错误堆栈）
# 生产环境: false
VITE_DEBUG_MODE=false

# 日志级别：ERROR / WARN / INFO / DEBUG（大小写敏感），未设置时按 ERROR
VITE_LOG_LEVEL=ERROR

# ============================================================================
# 说明
# ============================================================================

# 1. 未在此列的 VITE_* 变量（如 vite-env.d.ts 里声明的 VITE_API_URL、
#    VITE_API_TIMEOUT、VITE_APP_ENV、VITE_ENABLE_TYPING_EFFECT、
#    VITE_ENABLE_SOUND_EFFECTS）目前没有任何代码读取，属预留声明
# 2. 错误上报未接入第三方 SDK：仓库不含 Sentry 依赖，故无 VITE_SENTRY_*
#    配置项（此前文档里列过，已删除以免误导）
